# ==============================================================================
# ChartLab Demo - Environment Configuration
# ==============================================================================

# OpenAI API Key (Required only when MOCK_MODE=false)
# Note: OpenAI API charges are separate from any ChatGPT Plus subscription.
OPENAI_API_KEY=

# Model selection for vision chart analysis (e.g. gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Set to true to run in offline simulation mode without invoking OpenAI APIs
MOCK_MODE=true

# Capture interval in seconds for periodic screenshots (default 60s)
# Note: Periodic capture is NOT synchronized candle-close capture.
CAPTURE_INTERVAL_SECONDS=60

# Maximum acceptable screenshot age in seconds before an analysis is flagged as STALE.
# Operational note: This is an operational latency threshold to prevent taking late action,
# NOT a validated market trading parameter.
MAX_SCREENSHOT_AGE_SECONDS=30

# Maximum incoming analysis requests per minute per IP to avoid accidental API runaway costs
MAX_REQUESTS_PER_MINUTE=15

# Strategy evaluation version (frozen during evaluation trials to avoid survivor bias)
STRATEGY_VERSION=v1.0.0
